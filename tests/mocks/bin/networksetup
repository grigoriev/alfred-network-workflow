#!/bin/bash
# Mock of networksetup. Toggle behavior with MOCK_* env vars.
case "$1" in
  -listallhardwareports)
    echo "Hardware Port: Wi-Fi"
    echo "Device: en0"
    echo "Ethernet Address: f8:06:c1:00:a3:cc"
    echo ""
    if [ "$MOCK_ETH" != "none" ]; then
      echo "Hardware Port: Thunderbolt Ethernet"
      echo "Device: en4"
      echo "Ethernet Address: 40:0c:8d:00:ef:8c"
      echo ""
    fi
    echo "VLAN Configurations"
    echo "==================="
    ;;
  -getairportpower) echo "Wi-Fi Power (en0): ${MOCK_WIFI_POWER:-On}" ;;
  -getinfo)
    echo "DHCP Configuration"
    echo "IP address: 192.168.1.100"
    echo "Subnet mask: 255.255.255.0"
    echo "Router: 192.168.1.1"
    echo "IPv6: Automatic"
    echo "IPv6 IP address: none"
    ;;
  -getdnsservers) echo "${MOCK_DNS:-8.8.8.8}" ;;
  -listpreferredwirelessnetworks) printf '\tHomeNet\n\tCoffeeShop\n' ;;
  *) echo "networksetup $*" ;;
esac
